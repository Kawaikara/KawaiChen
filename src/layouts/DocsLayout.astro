---
import BaseHead from '../components/BaseHead.astro';
import PersistentDocsShell from '../components/PersistentDocsShell.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { NavItem, SiteIdentity } from '../types';
import '../styles/tokens.css';
import '../styles/base.css';

interface SidebarItem extends NavItem {
  children?: SidebarItem[];
}

interface Props {
  title: string;
  description?: string;
  site?: SiteIdentity;
  nav?: NavItem[];
  sidebar?: SidebarItem[];
  lang?: string;
}

const {
  title,
  description,
  site = { title: 'KawaiChen' },
  nav = [],
  sidebar = [],
  lang = 'ko',
} = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={`${title} · ${site.title}`} {description}><slot name="head" /></BaseHead>
  </head>
  <body>
    <SiteHeader {site} {nav}><slot name="header-actions" slot="actions" /></SiteHeader>
    <PersistentDocsShell
      navigationAriaLabel="문서 탐색"
      navigationPersistenceKey="kawaichen-documentation-navigation"
      tocAriaLabel="페이지 목차"
    >
      <div class="kc-docs-navigation" slot="navigation">
        <slot name="sidebar">
          <ul>
            {sidebar.map((item) => (
              <li>
                <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
                {item.children && (
                  <ul>{item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}</ul>
                )}
              </li>
            ))}
          </ul>
        </slot>
      </div>
      <slot />
      <div class="kc-docs-toc" slot="toc"><slot name="toc" /></div>
    </PersistentDocsShell>
  </body>
</html>

<style>
  .kc-docs-navigation ul { list-style: none; margin: 0; padding: 0; }
  .kc-docs-navigation ul ul { border-left: 1px solid var(--kc-border); margin: .5rem 0 .8rem .45rem; padding-left: .8rem; }
  .kc-docs-navigation a { color: var(--kc-muted); display: block; padding: .35rem .5rem; text-decoration: none; }
  .kc-docs-navigation a:hover, .kc-docs-navigation a[aria-current='page'] { color: var(--kc-accent); }
  .kc-docs-toc { color: var(--kc-muted); font-size: .85rem; }
</style>
