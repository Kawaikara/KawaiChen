---
import { DocsLayout } from 'kawaichen';

const { frontmatter } = Astro.props;
const sidebar = [
  { label: 'Getting started', href: '/' },
  { label: 'Design principles', href: '/guide/principles/' },
];
---

<DocsLayout
  title={frontmatter.title}
  description={frontmatter.description}
  site={{ title: 'Acme Docs', homeHref: '/' }}
  nav={[{ label: 'Guide', href: '/' }, { label: 'GitHub', href: 'https://github.com', external: true }]}
  {sidebar}
  lang="en"
>
  <slot />
</DocsLayout>
